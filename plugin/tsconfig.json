{
  "compilerOptions": {
    "lib": ["esnext"],
    "types": ["node"],

    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "rootDir": "./src",
    "outDir": "./build",
    "declaration": true,
    "sourceMap": false,

    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "include": ["./src"]
}
