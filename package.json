{
  "name": "@minqian/react-native-wechat-lib",
  "version": "0.3.0",
  "description": "WeChat OpenSDK for Expo and React Native — login + share, New Architecture, config plugin included",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "plugin/build",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "ios",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "build:plugin": "node internal/module_scripts/build.js plugin",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "wechat",
    "weixin",
    "config-plugin",
    "react-native-wechat-lib"
  ],
  "repository": "https://github.com/yinminqian/react-native-wechat-lib",
  "bugs": {
    "url": "https://github.com/yinminqian/react-native-wechat-lib/issues"
  },
  "author": "yinminqian <yinminqian@gmail.com>",
